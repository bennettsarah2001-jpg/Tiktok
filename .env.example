# From https://developers.tiktok.com/apps -> your app -> Credentials
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must exactly match a redirect URI registered on your app (Login Kit settings)
TIKTOK_REDIRECT_URI=http://localhost:3000/auth/tiktok/callback
PORT=3000
# For trend research + video suggestions (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=
